{
  "type": "webhook",
  "name": "get_approval",
  "description": "Get the status of an approval request. Approvals are decided only by the manager on their own console.",
  "response_timeout_secs": 10,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "auto",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/approvals/{approval_id}",
    "method": "GET",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "approval_id",
        "approval"
      ]
    },
    "path_params_schema": {
      "approval_id": {
        "type": "string",
        "description": "approval_id as returned by a tool."
      }
    }
  }
}
