{
  "type": "webhook",
  "name": "plan_quantity",
  "description": "Turn a need in litres, kilograms or pieces into order units for one product. Never do this arithmetic yourself.",
  "response_timeout_secs": 10,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "auto",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/quantity/plan",
    "method": "POST",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "product_id",
        "api_unit",
        "units_needed",
        "total_content",
        "overshoot"
      ]
    },
    "content_type": "application/json",
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for plan_quantity.",
      "properties": {
        "product_id": {
          "type": "string",
          "description": "Six-digit Valio Aimo product id exactly as a tool returned it."
        },
        "amount": {
          "type": "number",
          "description": "How much the buyer needs, as a number."
        },
        "unit": {
          "type": "string",
          "description": "Unit of the amount: litres, kilograms or pieces.",
          "enum": [
            "L",
            "KG",
            "PCS"
          ]
        }
      },
      "required": [
        "product_id",
        "amount",
        "unit"
      ]
    }
  }
}
