{
  "type": "webhook",
  "name": "quote_basket",
  "description": "Make one fixed-price quote for every line of the basket. If it answers basket_incomplete, resolve the lines in open_lines first (choose an alternative, give an amount or remove the line), then call it again. Then call show_quote and request_buyer_confirmation with the quote_id. Never state a number that is not in this result.",
  "response_timeout_secs": 15,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "force",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/baskets/quote",
    "method": "POST",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "basket_id",
        "quote_id",
        "total_net",
        "total_gross",
        "expires_at",
        "open_lines"
      ]
    },
    "content_type": "application/json",
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for quote_basket.",
      "properties": {
        "basket_id": {
          "type": "string",
          "description": "basket_id exactly as a basket tool returned it. Never invent or edit it."
        }
      },
      "required": [
        "basket_id"
      ]
    }
  }
}
