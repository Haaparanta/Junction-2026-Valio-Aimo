{
  "type": "webhook",
  "name": "remove_basket_line",
  "description": "Remove one basket line, only when the buyer asks. The buyer can undo it on screen. Then call show_basket.",
  "response_timeout_secs": 10,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "auto",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/baskets/lines/remove",
    "method": "POST",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "basket_id",
        "basket",
        "line"
      ]
    },
    "content_type": "application/json",
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for remove_basket_line.",
      "properties": {
        "basket_id": {
          "type": "string",
          "description": "basket_id exactly as a basket tool returned it. Never invent or edit it."
        },
        "line_id": {
          "type": "integer",
          "description": "line_id exactly as a basket tool returned it."
        }
      },
      "required": [
        "basket_id",
        "line_id"
      ]
    }
  }
}
