{
  "type": "webhook",
  "name": "create_quote",
  "description": "Create a fixed-price quote from one offer_id that get_offers returned. Then call show_quote and request_buyer_confirmation with the quote_id.",
  "response_timeout_secs": 15,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "force",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/quotes",
    "method": "POST",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "quote_id",
        "total_net",
        "total_gross",
        "expires_at"
      ]
    },
    "content_type": "application/json",
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for create_quote.",
      "properties": {
        "offer_id": {
          "type": "string",
          "description": "offer_id exactly as returned by get_offers. Never invent or edit it."
        }
      },
      "required": [
        "offer_id"
      ]
    }
  }
}
