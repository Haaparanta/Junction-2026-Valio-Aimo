{
  "type": "webhook",
  "name": "cancel_order",
  "description": "Cancel an order that is not completed yet, only when the buyer asks to.",
  "response_timeout_secs": 10,
  "tool_error_handling_mode": "passthrough",
  "pre_tool_speech": "auto",
  "interruption_mode": "allow",
  "api_schema": {
    "url": "https://{{system__env_gateway_host}}/v1/orders/{order_id}/cancel",
    "method": "POST",
    "request_headers": {
      "X-Gateway-Key": {
        "secret_id": "<gateway_platform_key secret id>"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Session-Token": {
        "variable_name": "secret__session_token"
      }
    },
    "response_filter": {
      "mode": "allow",
      "filters": [
        "status",
        "reason_code",
        "message_for_user",
        "warnings",
        "order_id"
      ]
    },
    "path_params_schema": {
      "order_id": {
        "type": "string",
        "description": "order_id exactly as place_order returned."
      }
    },
    "content_type": "application/json",
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for cancel_order.",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Short reason the buyer gave, if any. Default: \"\"."
        }
      }
    }
  }
}
