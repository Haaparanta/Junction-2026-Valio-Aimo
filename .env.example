# Names only. Real values live in git-ignored files, never in git:
#   .env          challenge key (VALIO_AIMO_API_KEY)
#   .env.local    ELEVENLABS_API_KEY, written by `npx -y @elevenlabs/cli@latest onboard init`
#   .env.gateway  gateway secrets, written by scripts/gen_secrets.py and agent/provision.py
# In the cloud sandbox the network proxy injects the challenge key and the ElevenLabs key.

VALIO_AIMO_API_KEY=
VALIO_AIMO_API_BASE_URL=https://junction26.valioaimo.fi/api

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
GATEWAY_PLATFORM_KEY=

# Claude for the photo and dish features. The key is optional: the SDK also reads an `ant auth login` profile.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
DISH_MODEL=claude-opus-5-5

# Public host of the gateway without scheme, e.g. the ngrok domain from `ngrok http 8000`.
PUBLIC_HOST=
# Demo as-of clock (PLAN M3.3)
AS_OF=2026-11-14T10:00:00+02:00
